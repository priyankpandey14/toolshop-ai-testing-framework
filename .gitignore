# Dependencies
node_modules/

# Playwright / execution evidence
# Keep the HTML report tracked so reviewers can open it without regenerating.
# Ignore bulky traces and ephemeral failure artifacts only.
PrismStructure/execution-evidence/test-results/**
!PrismStructure/execution-evidence/test-results/.gitkeep
PrismStructure/execution-evidence/logs/**
!PrismStructure/execution-evidence/logs/.gitkeep
!PrismStructure/execution-evidence/logs/results.json
!PrismStructure/execution-evidence/logs/complete-suite.log
!PrismStructure/execution-evidence/logs/smoke-suite.log
!PrismStructure/execution-evidence/logs/regression-suite.log

# Legacy artifact paths (removed after migration; keep ignored if recreated)
PrismStructure/test-results/
PrismStructure/playwright-report/
PrismStructure/screenshots/**
!PrismStructure/screenshots/.gitkeep
blob-report/
playwright/.cache/

# Auth / local secrets (never commit)
.auth/
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log
!PrismStructure/execution-evidence/logs/*.log
.idea/
.vscode/
